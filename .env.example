# PostgreSQL database connection string (Neon or Supabase with pgvector enabled)
# Example: postgresql://neha:password@ep-abc.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/job_matching

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM model for resume parsing and match explanation
GEMINI_MODEL=gemini-2.5-flash

# Text embedding model and dimension
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
